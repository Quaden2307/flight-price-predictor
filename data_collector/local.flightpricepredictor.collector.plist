<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.flightpricepredictor.collector</string>

    <!-- Each argv entry is its own <string>, so paths with spaces need no
         escaping. collect.py opens "data/flights.db" relatively, which is why
         WorkingDirectory below has to be the repo root. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
        <string>data_collector/collect.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/quaden/Library/Mobile Documents/com~apple~CloudDocs/Desktop/Developer/Main Projects/flight-price-predictor</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Absolute; launchd opens these before applying WorkingDirectory. -->
    <key>StandardOutPath</key>
    <string>/Users/quaden/Library/Mobile Documents/com~apple~CloudDocs/Desktop/Developer/Main Projects/flight-price-predictor/logs/collector.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/quaden/Library/Mobile Documents/com~apple~CloudDocs/Desktop/Developer/Main Projects/flight-price-predictor/logs/collector.err.log</string>

    <!-- MUST stay false. True would fire a run the moment you bootstrap this,
         which — combined with tomorrow's 06:00 run — would put two captures on
         the same UTC day (the May 31 duplicate situation). -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
